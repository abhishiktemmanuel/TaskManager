# Server port (defaults to 3000 or process.env.PORT)
PORT=3000

# Frontend origins for CORS (comma separated in production)
FRONTEND_URL=http://localhost:5173,http://localhost:80

# Cloud Database Connection String (Optional, takes precedence over DB_* if set)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
# DB_SSL=true

# Local Database Connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=task_manager

# Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=86400s
UPLOAD_PATH=./uploads